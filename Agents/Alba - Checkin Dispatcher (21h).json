      "name": "Dados do usuário"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://firestore.googleapis.com/v1/projects/alba-1e168/databases/(default)/documents:runQuery",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleFirebaseCloudFirestoreOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"structuredQuery\": {\n    \"from\": [{ \"collectionId\": \"Metas\" }],\n    \"where\": {\n      \"compositeFilter\": {\n        \"op\": \"AND\",\n        \"filters\": [\n          { \"fieldFilter\": { \"field\": { \"fieldPath\": \"user_id\" }, \"op\": \"EQUAL\", \"value\": { \"stringValue\": \"{{ $json.phone }}\" } } },\n          { \"fieldFilter\": { \"field\": { \"fieldPath\": \"status\" }, \"op\": \"EQUAL\", \"value\": { \"stringValue\": \"ativa\" } } }\n        ]\n      }\n    }\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        6832,
        2288
      ],
      "id": "81c13381-6b41-4851-b6af-b4c1434630fd",
      "name": "Buscar metas ativas (REST API)",
      "credentials": {
        "googleFirebaseCloudFirestoreOAuth2Api": {
          "id": "ymvhjRpIIFNIGvGB",
          "name": "Google Firebase Cloud Firestore account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const results = $input.all().map(i => i.json);\nconst usuario = $('Dados do usuário').item.json;\nconst agora = new Date();\nconst dateStr = agora.toISOString().split('T')[0];\n\nconst metas = results\n  .filter(r => r.document)\n  .map(r => {\n    const doc = r.document;\n    const id = doc.name.split('/').pop();\n    const f = doc.fields ?? {};\n    const getStr = (field) => field?.stringValue ?? null;\n    return { id, titulo: getStr(f.titulo), categoria: getStr(f.categoria), prazo: getStr(f.prazo) };\n  })\n  .filter(m => m.titulo);\n\nconst estadoCheckin = {\n  currentStep: 'mood',\n  date: dateStr,\n  userName: usuario.userName,\n  userId: usuario.phone,\n  dailyTasks: metas,\n  answers: { mood: null, completedTasks: [], rest: null, bottleneck: null, gratitude: null },\n  isCompleted: false\n};\n\nreturn [{ json: { phone: usuario.phone, userName: usuario.userName, date: dateStr, dailyTasks: metas, estadoCheckin: JSON.stringify(estadoCheckin) } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        7072,
        2288
      ],
      "id": "57e8d658-5d11-4de6-9617-6be65eace444",
