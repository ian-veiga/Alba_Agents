    {
      "parameters": {
        "jsCode": "const docs = $input.first().json.documents ?? [];\nif (docs.length === 0) return [];\nreturn docs.map(doc => {\n  const phone = doc.name.split('/').pop();\n  const fields = doc.fields ?? {};\n  const getStr = (f) => f?.stringValue ?? f?.integerValue ?? null;\n  return {\n    json: {\n      id: phone,\n      phone: phone,\n      nome: getStr(fields.nome) ?? getStr(fields.name) ?? 'Estudante'\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        6112,
        2288
      ],
