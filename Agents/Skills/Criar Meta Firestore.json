{
  "name": "Criar Meta Firestore",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst categoriasValidas = ['faculdade', 'negocio', 'bemestar'];\nconst prioridadesValidas = ['alta', 'media', 'baixa'];\nconst erros = [];\n\nif (!input.userId) erros.push('user_id obrigatorio');\nif (!categoriasValidas.includes(input.categoria)) erros.push(`categoria invalida: \"${input.categoria}\" — use faculdade, negocio ou bemestar`);\nif (!prioridadesValidas.includes(input.prioridade)) erros.push(`prioridade invalida: \"${input.prioridade}\" — use alta, media ou baixa`);\n\nlet prazoISO = null;\nif (input.prazo) {\n  const prazoStr = input.prazo.includes('T') ? input.prazo : `${input.prazo}T12:00:00-03:00`;\n  const d = new Date(prazoStr);\n  if (isNaN(d.getTime())) erros.push(`prazo invalido: \"${input.prazo}\" — use YYYY-MM-DD`);\n  else prazoISO = d.toISOString();\n}\n\nif (erros.length > 0) {\n  return [{ json: { sucesso: false, mensagem: `Falha: ${erros.join('; ')}` } }];\n}\n\nconst agora = new Date().toISOString();\n\nreturn [{\n  json: {\n    sucesso: true,\n    documento: {\n      userId:    input.user_id,\n      tituloMeta:     input.titulo,\n      descricao:  input.descricao || '',\n      tag:  input.categoria,\n      prioridade: input.prioridade,\n      status:     'ativa',\n      progresso:  0,\n      prazo:      prazoISO,\n      dataCriacao: agora,\n      dataAtualizacao: agora\n    },\n    resumo: {\n      titulo:     input.titulo,\n      tag:  input.categoria,\n      prioridade: input.prioridade\n    }\n  }\n}];"
      },
